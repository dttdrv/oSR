{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022-debug",
      "displayName": "Visual Studio 2022 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs2022-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OSR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OSR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-core",
      "displayName": "Portable Linux/Core Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OSR_BUILD_TESTS": "ON",
        "OSR_BUILD_DX12": "OFF",
        "OSR_BUILD_WIN32_HARNESS": "OFF",
        "OSR_BUILD_XESS_PROXY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core"
    }
  ],
  "testPresets": [
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
